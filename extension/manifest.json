{
  "manifest_version": 3,
  "name": "VoxFront Voice Changer",
  "version": "0.1.0",
  "description": "Change your voice on any website that uses the microphone — Meet, Discord, recorders and more. Rust + WebAssembly DSP, processed locally.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Voice changer" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["voice_changer.wasm", "voice-changer-processor.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
